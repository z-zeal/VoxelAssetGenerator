{
  "name": "voxel-asset-generation-bundle",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/elevation.test.js tests/voxel-projection.test.js",
    "voxels:build": "node tools/voxel_pipeline/build.mjs",
    "voxels:preview": "node tools/voxel_pipeline/preview.mjs",
    "voxels:bake": "node tools/voxel_pipeline/bake.mjs",
    "voxels:all": "npm run voxels:build && npm run voxels:preview && npm run voxels:bake",
    "voxels3:bake": "node tools/voxel_pipeline/v3/bake.mjs",
    "voxels3:tank": "node tools/voxel_pipeline/v3/bake.mjs --only tank",
    "voxels3:buildings": "node tools/voxel_pipeline/v3/bake.mjs --only barracks,at-turret",
    "voxels3:ps1": "powershell -File tools/voxel_pipeline/v3/bake-all.ps1",
    "voxels3:all": "node tools/voxel_pipeline/v3/bake.mjs && node tools/voxel_pipeline/v3/contact.mjs",
    "voxels3:contact": "node tools/voxel_pipeline/v3/contact.mjs",
    "voxels3:review": "node tools/voxel_pipeline/v3/serve.mjs"
  }
}
